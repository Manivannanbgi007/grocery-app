# payment-service: your local settings. Copy this file to ".env" (same folder) and fill it in.
# ".env" is in .gitignore: your keys stay on your machine. Never put real keys in this example file.
# The service reads .env when it starts (profile "local", the default), so restart payment-service after a change.

# mock     = the built-in test gateway (no Razorpay, no real money): the order page shows "Pay" and "Decline (test)"
# razorpay = Razorpay Checkout: then the four RAZORPAY_ lines below must be filled in, or the service does not start
PAYMENT_GATEWAY=mock

# test or live. Test mode takes only test keys (rzp_test_...), live mode only live keys (rzp_live_...)
RAZORPAY_MODE=test

# Razorpay Dashboard (switch to Test Mode) > Account & Settings > API Keys > Generate Key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# The secret you type when you create the webhook (Dashboard > Account & Settings > Webhooks, events payment.captured
# and payment.failed). Any long random text; without a webhook (no tunnel) still set one.
RAZORPAY_WEBHOOK_SECRET=any_long_random_text
