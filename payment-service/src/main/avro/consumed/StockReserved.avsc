{
  "type": "record",
  "name": "StockReserved",
  "namespace": "com.grocery.events.inventory",
  "doc": "Every item of the order is reserved (held for it). payment-service then confirms COD or lets the customer pay online. Producer: inventory-service. Topic: grocery.inventory.events, key = orderId.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique id of this event (UUID). Consumers use it to skip duplicates."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "orderId",
      "type": "long"
    },
    {
      "name": "storeId",
      "type": "long"
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "ReservedItem",
          "fields": [
            {
              "name": "productId",
              "type": "long"
            },
            {
              "name": "quantity",
              "type": "int"
            }
          ]
        }
      }
    }
  ]
}
