{
  "type": "record",
  "name": "OrderAccepted",
  "namespace": "com.grocery.events.order",
  "doc": "The store accepted the order. Producer: order-service. Topic: grocery.order.events, key = orderId.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique id of this event (UUID). Consumers use it to skip duplicates."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "orderId",
      "type": "long"
    },
    {
      "name": "customerUserId",
      "type": "long"
    },
    {
      "name": "storeId",
      "type": "long"
    }
  ]
}
