    {
      "type": "timeseries",
      "title": "Keys",
      "description": "Keys in Redis, and how many of them expire by themselves (a TTL): rate-limit counters, partner presence and locations.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(redis_db_keys)",
          "legendFormat": "keys"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(redis_db_keys_expiring)",
