                  {
                    "title": "Traces of ${__value.raw} in Jaeger",
                    "url": "http://localhost:16686/search?service=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
