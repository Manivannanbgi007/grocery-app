{
  "uid": "grocery-services",
  "title": "Grocery services",
  "description": "Every service at a glance: up, healthy, traffic, errors, response times, resources, Kafka, gateway, alerts.",
  "tags": [
    "grocery"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Service details",
      "type": "link",
      "url": "/d/grocery-service-details",
      "icon": "dashboard"
    },
    {
      "title": "Events (Kafka, Debezium)",
      "type": "link",
      "url": "/d/grocery-events",
      "icon": "dashboard"
    },
    {
      "title": "Infrastructure (MySQL, Redis, Elasticsearch)",
      "type": "link",
      "url": "/d/grocery-infrastructure",
      "icon": "dashboard"
    },
    {
      "title": "SLOs",
      "type": "link",
      "url": "/d/grocery-slos",
      "icon": "dashboard"
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/grocery-logs",
      "icon": "doc"
    },
    {
      "title": "Traces (Jaeger)",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list",
      "icon": "bolt"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Services up",
      "description": "Services Prometheus can read (of 16).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"grocery-services\"} == 1) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "green",
                "value": 16
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Services down",
      "description": "Services Prometheus cannot reach: stopped, crashed or not started. Alert: ServiceDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"grocery-services\"} == 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Unhealthy",
      "description": "Services that run but whose /actuator/health is not UP (database, Redis ... down). Alert: ServiceUnhealthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success{job=\"service-health\"} == 0 unless on (service) up{job=\"grocery-services\"} == 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alerts that fire now (list below; Grafana -> Alerting for all of them).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Requests / s (gateway)",
      "description": "Requests of all clients (website, apps) per second, as the API gateway sees them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"api-gateway\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Server errors (gateway)",
      "description": "Share of the client requests that ended with a 5xx answer (last 5 minutes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{service=\"api-gateway\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{service=\"api-gateway\", uri!~\"/actuator.*\"}[5m])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "All services (click a name for its details)",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Services",
      "description": "One row per service, from the last 5 minutes. Empty cells: no requests (or no database). Response time without the AI chat and live tracking streams (long on purpose); not for the gateway (its time includes the service behind it). Click a service name for its details dashboard or its traces in Jaeger.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (up{job=\"grocery-services\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (probe_success{job=\"service-health\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"grocery-services\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service) (rate(http_server_requests_seconds_count{job=\"grocery-services\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or sum by (service) (rate(http_server_requests_seconds_count{job=\"grocery-services\", uri!~\"/actuator.*\"}[5m])) * 0) / (sum by (service) (rate(http_server_requests_seconds_count{job=\"grocery-services\", uri!~\"/actuator.*\"}[5m])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"grocery-services\", service!=\"api-gateway\", uri!~\"/actuator.*\", uri!~\"/api/v1/chat/messages|.*/stream\"}[5m]))) >= 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (jvm_memory_used_bytes{job=\"grocery-services\", area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{job=\"grocery-services\", area=\"heap\"} > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (process_cpu_usage{job=\"grocery-services\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (hikaricp_connections_active) / sum by (service) (hikaricp_connections_max)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (process_uptime_seconds{job=\"grocery-services\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              },
              {
                "id": "links",
                "value": [
