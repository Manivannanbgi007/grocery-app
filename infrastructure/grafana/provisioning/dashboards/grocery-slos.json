{
  "uid": "grocery-slos",
  "title": "Grocery SLOs",
  "description": "Service level objectives of the platform, measured at the API gateway (infrastructure/prometheus/alerts/slo-rules.yml, docs/observability.md#slos).",
  "tags": [
    "grocery"
  ],
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "links": [
    {
      "title": "Services",
      "type": "link",
      "url": "/d/grocery-services",
      "icon": "dashboard"
    },
    {
      "title": "Service details",
      "type": "link",
      "url": "/d/grocery-service-details",
      "icon": "dashboard"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list",
      "icon": "bolt"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Last 7 days: the SLOs (availability 99.5 %, 99 % within 1 s) and how much error budget is left",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Availability",
      "description": "Share of the requests through the gateway answered without a server error (5xx) in the last 7 days. SLO: 99.5 %. Swagger UI routes are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:gateway_error_ratio:rate7d",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Error budget left (availability)",
      "description": "The SLO allows 0.5 % failed requests per 7 days: the error budget. 100 % = nothing used, 0 % = used up (below 0: the SLO is missed). While it is low, prefer fixing reliability over new features.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:gateway_error_ratio:rate7d / 0.005",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Answered within 1 s",
      "description": "Share of the requests answered within 1 second in the last 7 days. SLO: 99 %. Not counted: the AI chat and voice (seconds by design), the live streams (routes named *-stream: delivery tracking, the vendors' orders) and the Swagger UI routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:gateway_slow_ratio:rate7d",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Error budget left (latency)",
      "description": "The SLO allows 1 % of the requests to take longer than 1 s per 7 days. 100 % = nothing used, 0 % = used up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:gateway_slow_ratio:rate7d / 0.01",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Requests",
      "description": "Requests through the gateway in the last 7 days (the base of the percentages).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\"}[7d]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "Burn rate: how many times faster than allowed the budget is used (1 = it lasts exactly 7 days)",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Availability burn rate",
      "description": "Error share divided by the allowed 0.5 %. Alerts: ErrorBudgetBurningFast when the 1 h line is above 14.4 (and still above in the last 5 min), ErrorBudgetBurningSlowly when the 6 h line is above 6 (and in the last 30 min). Needs at least one request per minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:gateway_error_ratio:rate1h / 0.005",
          "legendFormat": "last 1 h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:gateway_error_ratio:rate6h / 0.005",
          "legendFormat": "last 6 h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(14.4)",
          "legendFormat": "alert: fast (1 h)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(6)",
          "legendFormat": "alert: slow (6 h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "alert.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency burn rate",
      "description": "Share of requests slower than 1 s divided by the allowed 1 %. Alert LatencyBudgetBurning when the 6 h line is above 6 (and in the last 30 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:gateway_slow_ratio:rate30m / 0.01",
          "legendFormat": "last 30 min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:gateway_slow_ratio:rate6h / 0.01",
          "legendFormat": "last 6 h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(6)",
          "legendFormat": "alert (6 h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "alert.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Where the budget goes (in the selected time range)",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Server errors by route",
      "description": "Requests answered with a 5xx, per gateway route, in the selected time range. The route names the service; its own alerts and Grocery service details say why. Counts are estimated from samples taken every 15 s, so small numbers can have decimals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\", httpStatusCode=~\"5..\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\", httpStatusCode=~\"5..\"}[$__range]))) / (sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "routeId": "Route",
              "Value #A": "Server errors",
              "Value #B": "Share"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Server errors",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Server errors"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Requests slower than 1 s by route",
      "description": "Requests that took longer than 1 second, per gateway route, in the selected time range (without the chat, voice and the live streams). Then Grocery service details: slowest endpoints, repository and outgoing calls. Counts are estimated from samples taken every 15 s, so small numbers can have decimals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_bucket{routeId!~\".*-api-docs|mcp-client-service-chat|mcp-client-service-voice|.*-stream\", le=\"+Inf\"}[$__range])) - sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_bucket{routeId!~\".*-api-docs|mcp-client-service-chat|mcp-client-service-voice|.*-stream\", le=\"1.0\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_bucket{routeId!~\".*-api-docs|mcp-client-service-chat|mcp-client-service-voice|.*-stream\", le=\"+Inf\"}[$__range])) - sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_bucket{routeId!~\".*-api-docs|mcp-client-service-chat|mcp-client-service-voice|.*-stream\", le=\"1.0\"}[$__range]))) / (sum by (routeId) (increase(spring_cloud_gateway_requests_seconds_bucket{routeId!~\".*-api-docs|mcp-client-service-chat|mcp-client-service-voice|.*-stream\", le=\"+Inf\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "routeId": "Route",
              "Value #A": "Slower than 1 s",
              "Value #B": "Share"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Slower than 1 s",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Slower than 1 s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second through the gateway",
      "description": "All user requests, by result: OK (2xx/3xx), client errors (4xx: not counted against the SLO, e.g. a wrong password) and server errors (5xx).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\", httpStatusCode!~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "OK"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\", httpStatusCode=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "client errors (4xx)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{routeId!~\".*-api-docs\", httpStatusCode=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "server errors (5xx)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "alert.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      }
    }
  ]
}
