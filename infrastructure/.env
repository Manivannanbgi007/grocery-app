# ---------------------------------------------------------------------
# Image versions and local-only passwords for docker-compose.yml.
# Docker Compose reads this file automatically.
# Change a version here, then run scripts/start-infra.ps1 again.
# ---------------------------------------------------------------------

# Databases and caches
MYSQL_VERSION=8.4.13
REDIS_VERSION=8.10.2-alpine

# Kafka stack (Confluent 8.2.x = Apache Kafka 4.2, same as the Spring Boot 4.1 Kafka client)
CONFLUENT_VERSION=8.2.4
DEBEZIUM_VERSION=3.7.0.Final
# Prometheus JMX exporter agent inside the Kafka Connect image (connector and Debezium metrics)
JMX_EXPORTER_VERSION=1.7.0

# Search (must match the Elasticsearch client version managed by Spring Boot 4.1.2)
ELASTIC_VERSION=9.4.8

# AI assistant (profile "ai"): the Ollama server and the Qwen model it downloads on start.
# qwen3:4b-instruct-2507-q4_K_M (2.5 GB): answers directly (no "thinking" text), calls tools well, 3-15 s per answer
#   on a CPU (measured in phase A1, see docs/ai-assistant-plan.md).
# qwen3:8b (5.2 GB): a little more careful, but 4-6 times slower without an NVIDIA GPU.
# Do NOT use the plain "qwen3:4b" tag: it is the "thinking" build and writes its reasoning into every answer.
# The services read the model name from OLLAMA_CHAT_MODEL too (same default).
OLLAMA_VERSION=0.40.11
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Voice (profile "ai"): speaches understands spoken questions and reads answers aloud. 0.8.3 = the latest stable
# release (0.9.0 is still a release candidate). English only: the ".en" Whisper model is smaller and faster on a CPU.
# The services read the same model names (SPEECH_TRANSCRIPTION_MODEL, SPEECH_VOICE_MODEL).
SPEACHES_VERSION=0.8.3-cpu
SPEECH_TRANSCRIPTION_MODEL=Systran/faster-distil-whisper-small.en
SPEECH_VOICE_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX

# Developer tools
MAILPIT_VERSION=v1.32.0
KAFKA_UI_VERSION=v1.5.0
REDISINSIGHT_VERSION=3.8.0
MOCK_OAUTH2_SERVER_VERSION=6.1.3
PROMETHEUS_VERSION=v3.15.1
GRAFANA_VERSION=13.2.4
# Jaeger: stay on 2.20.x for now. 2.21 removed the HTTP API that Grafana's Jaeger data source (13.0.x) uses to SEARCH
# traces; upgrade once Grafana searches through Jaeger's v3 API (check: Grafana -> Explore -> Jaeger -> Search works).
JAEGER_VERSION=2.20.0
ALERTMANAGER_VERSION=v0.34.1
BLACKBOX_EXPORTER_VERSION=v0.29.0
# Consumer-group lag from the broker. Checked with Kafka 4.2 (needs --kafka.version=4.2.0, see docker-compose.yml)
KAFKA_EXPORTER_VERSION=v1.10.0
# Data store exporters (profile monitoring). mysqld-exporter 0.17.2+ knows MySQL 8.4; elasticsearch-exporter 1.10+
# needs --es.uri (it has no default any more).
MYSQLD_EXPORTER_VERSION=v0.20.0
REDIS_EXPORTER_VERSION=v1.93.0
ELASTICSEARCH_EXPORTER_VERSION=v1.11.0
LOKI_VERSION=3.7.9

# Local development passwords only - never reuse these anywhere else
MYSQL_ROOT_PASSWORD=root
GRAFANA_ADMIN_PASSWORD=admin
# The MySQL exporter's user (created in mysql/init/01-create-databases-and-users.sql with the same password)
MYSQL_EXPORTER_PASSWORD=exporter_pass
# Kibana (profile tools): any text of 32+ characters. Production: a random key (bin/kibana-encryption-keys generate)
KIBANA_ENCRYPTION_KEY=local-only-kibana-encryption-key-0123456789
# Redis users (docker-compose.yml, redis: --user lines). Local values only; the services use the same defaults
# (api-gateway: gateway, delivery-service: delivery). Production: long random passwords from a secret store.
REDIS_ADMIN_PASSWORD=admin_pass
REDIS_GATEWAY_PASSWORD=gateway_pass
REDIS_DELIVERY_PASSWORD=delivery_pass
REDIS_EXPORTER_PASSWORD=exporter_pass
