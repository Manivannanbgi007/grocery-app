# Copy to .env.local (not committed) to override .env.development on your machine.

# true  = answer API calls in the browser with the demo catalog (Mock Service Worker), no backend needed
# false = call the real backend (the API gateway)
VITE_API_MOCKING=false

# Where the API gateway is. Leave empty in development: the Vite dev server proxies /api to http://localhost:8080.
# Set it only when the app is served from a different host than the gateway, e.g. https://api.example.com
VITE_API_BASE_URL=

# Delivery tracking maps (src/config/tracking.ts, docs/delivery-tracking.md). Empty = the defaults:
# OpenStreetMap's own tiles - fine for development, NOT for a production shop (volunteer servers, light use only).
# Production: your tile provider's URL with its key, and its attribution text (keep "OpenStreetMap contributors").
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Where the map looks before a delivery's points are known: "latitude,longitude" (default Bengaluru)
VITE_MAP_DEFAULT_CENTER=
