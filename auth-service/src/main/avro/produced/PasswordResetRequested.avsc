{
  "type": "record",
  "name": "PasswordResetRequested",
  "namespace": "com.grocery.events.user",
  "doc": "A user asked to reset their password. notification-service emails the token. Producer: auth-service. Topic: grocery.user.events, key = userId.",
  "fields": [
    { "name": "eventId",    "type": "string", "doc": "Unique id of this event (UUID). Consumers use it to skip duplicates." },
    { "name": "occurredAt", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "userId",     "type": "long" },
    { "name": "fullName",   "type": "string" },
    { "name": "email",      "type": "string" },
    { "name": "encryptedResetToken", "type": ["null", "string"], "default": null,
      "doc": "The token, encrypted with AES-256-GCM (ResetTokenCipher, key PASSWORD_RESET_EVENT_KEY, which only auth-service and notification-service have): \"v1.\" + Base64url(IV + encrypted token + tag), the user id bound as additional data. Null only in events written before 2026-10-28 (schema version 1 had the token in plain text, field resetToken, removed in version 3); their tokens expired 30 minutes after they were issued." },
    { "name": "expiresAt",  "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
