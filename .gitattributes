# Normalise line endings in the repository
* text=auto

# Files executed inside Linux containers must keep LF line endings,
# even when the repo is checked out on Windows.
*.sh     text eol=lf
mvnw     text eol=lf
Dockerfile text eol=lf

# Windows scripts
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.jar    binary
*.png    binary
*.jpg    binary
